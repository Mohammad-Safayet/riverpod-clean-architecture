# Run from android/:  bundle exec fastlane <lane>
# The bundle must already be built: make aab-prod

default_platform(:android)

AAB_PATH = "../build/app/outputs/bundle/prodRelease/app-prod-release.aab"

platform :android do
  desc "Upload the prod bundle to the Play internal testing track"
  lane :deploy_internal do
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the latest internal release to production (manual step)"
  lane :promote_production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
